{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simatlabs.com/ifa/event_types/person_detected@1.json",
  "title": "Person detected",
  "description": "One or more persons present in frame at the monitoring point.",
  "type": "object",
  "required": ["person_count", "confidence"],
  "properties": {
    "person_count": { "type": "integer", "minimum": 1 },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Highest per-person confidence in the frame."
    },
    "detections": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["confidence", "bbox"],
        "properties": {
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "bbox": {
            "type": "array",
            "description": "[x1, y1, x2, y2] pixel coords in the source frame.",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
