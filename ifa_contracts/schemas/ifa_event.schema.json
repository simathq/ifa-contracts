{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simatlabs.com/ifa/ifa_event.schema.json",
  "title": "IFA_EVENT envelope v1",
  "description": "Universal envelope for every event an IFA module emits. The payload is typed per event_type; its schema lives in the event_types registry (contracts/event_types/), referenced by (event_type, event_type_version).",
  "type": "object",
  "required": [
    "ifa_event_version",
    "event_id",
    "module_instance_id",
    "event_type",
    "event_type_version",
    "occurred_at",
    "location",
    "sources",
    "payload"
  ],
  "properties": {
    "ifa_event_version": { "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "module_instance_id": { "type": "string", "format": "uuid" },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "description": "Bare snake_case for module events; the dotted form reserves namespaces (platform.*) for non-module events."
    },
    "event_type_version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "severity": { "enum": ["info", "warning", "critical"] },
    "location": {
      "type": "object",
      "required": ["factory", "line"],
      "properties": {
        "factory": { "type": "string" },
        "line": { "type": "string" },
        "zone": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stream_id"],
        "properties": {
          "stream_id": { "type": "string" },
          "frame_ts": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "media": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "enum": ["frame", "clip", "crop"] },
          "ref": { "type": "string" },
          "stream_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
